# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Network caches — HuggingFace weights and partial git clones.
# Inputs, not results: re-downloaded on demand, several GB.
# ---------------------------------------------------------------------------
cache/

# ---------------------------------------------------------------------------
# Run state — resume checkpoints and logs. Regenerated by re-running a stage;
# committing them would make a resumed run pick up another machine's progress.
# ---------------------------------------------------------------------------
ckpt/
logs/

# ---------------------------------------------------------------------------
# Hidden states — [n, L+1, d] fp16 arrays, ~3.2 GB. Rebuilt by
# `scripts/s06_probe.py`, which resumes per batch. The per-layer probe results
# derived from them ARE committed, in out/06_probe.json.
# ---------------------------------------------------------------------------
out/*.npy
out/emb_*_ids.json

# ---------------------------------------------------------------------------
# Derived corpora — rebuilt in under a minute from dataset/ by stages 01, 03
# and 04. The artefacts that are NOT cheaply reproducible are committed
# explicitly below.
# ---------------------------------------------------------------------------
data/prepped.csv
data/structural.csv
data/structural_full.csv
data/structural_witnesses.json

# The hand audit is 50 methods read by a person and cannot be regenerated by
# re-running anything; the mined pairs cost ~25 minutes of network fetching.
!data/04_audit_labels.json
!data/04_audit_template.json
!data/cue_vocab.json
!data/rename_map.json
!data/minimal_pairs.csv
!data/minimal_pairs_excluded.csv

# ---------------------------------------------------------------------------
# Smoke runs — isolated trees so a smoke run cannot contaminate real results.
# Disposable by construction.
# ---------------------------------------------------------------------------
data_smoke/
out_smoke/
ckpt_smoke/
reports_smoke/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
